# Copy this file to .env and fill in real values locally. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?connect_timeout=15"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_SECRET="same-as-NEXTAUTH_SECRET"

# Google SSO (optional) — from Google Cloud Console OAuth client
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# Google Analytics (optional) — GA4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
